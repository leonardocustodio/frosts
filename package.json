{
  "name": "frosts",
  "version": "0.2.2",
  "private": true,
  "description": "TypeScript implementation of FROST (Flexible Round-Optimized Schnorr Threshold) signatures for threshold cryptography",
  "contributors": [
    {
      "name": "Leonardo Custodio",
      "email": "leonardo.custodio@parity.io",
      "url": "https://github.com/leonardocustodio"
    }
  ],
  "homepage": "https://github.com/leonardocustodio/frost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardocustodio/frost.git"
  },
  "bugs": {
    "url": "https://github.com/leonardocustodio/frost/issues"
  },
  "keywords": [
    "frost",
    "threshold signatures",
    "schnorr",
    "cryptography",
    "multi-party computation",
    "mpc",
    "distributed key generation",
    "dkg",
    "blockchain commons",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "docs": "turbo run docs",
    "deploy:docs": "bun run scripts/build-docs.ts",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "bump-version": "bun run scripts/bump-version.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "shared/*",
    "packages/*"
  ]
}
